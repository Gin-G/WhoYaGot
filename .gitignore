# Node
node_modules/
dist/
*.log

# Capacitor / Android build output. The android/ project itself is committed
# so the Gradle config and manifest stay under review.
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/res/xml/config.xml
*.apk
*.aab

# Android signing material. CI writes these from secrets and deletes them; they
# must never reach the repo.
*.keystore
*.jks
keystore.properties

# Editors / OS
.DS_Store
.idea/
.vscode/

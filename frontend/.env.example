# Where the WhoYaGot API lives.
# Leave unset for local dev — Vite proxies /api to VITE_DEV_API instead.
# REQUIRED for the Android build: the webview has no dev proxy, so it needs an
# absolute URL.
# VITE_API_URL=https://whoyagot-api.nickknows.net

# Google OAuth *web* client ID. Without it the app still runs — voting works
# anonymously and only "My list" prompts to sign in.
# Android uses this same web ID: Play Services takes a server client ID and
# stamps it into the token's aud. It is read at build time by capacitor.config.ts
# and baked into the APK by `cap sync`, so the Android build needs it set.
# VITE_GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Local dev only: which backend the Vite proxy forwards /api to.
# VITE_DEV_API=http://127.0.0.1:8000

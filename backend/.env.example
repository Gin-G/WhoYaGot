# Postgres in production; omit entirely to use a local SQLite file for dev.
# DATABASE_URL=postgresql://whoyagot:whoyagot@localhost:5432/whoyagot

# Google OAuth client IDs allowed to sign in, comma separated.
# The web client ID is required. Add the Android client ID too if the Play
# build uses its own — Google stamps the requesting client into the token's aud.
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com

# Signs WhoYaGot's own session tokens. Generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_TTL_DAYS=30

# Upstream NFL data
NFL_API_URL=https://nfl-api.nickknows.net
# Roster statuses that enter the voting pool: ACT, INA, DEV, RES, CUT, RET
NFL_POOL_STATUSES=ACT

# Guards POST /admin/sync. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# Origins allowed to call the API. https://localhost and capacitor://localhost
# are the Android webview.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://localhost,capacitor://localhost
